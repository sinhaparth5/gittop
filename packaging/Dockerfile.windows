# The toolchain scripts/build-windows.sh builds in: a mingw-w64 cross compiler
# for x86_64 Windows, and Wine to run what comes out.
#
# Pinned to a Debian release rather than :latest so the cross toolchain does not
# change under the script between one checkout and the next — a port that
# compiles on Tuesday and not on Thursday for reasons nobody changed is worse
# than one that does not compile at all.
FROM debian:trixie

# The i386 architecture is here for one reason: makensis emits a 32-bit
# installer whatever it is packaging, so a 64-bit-only Wine cannot run the
# artifact this image exists to build. Without wine32 the installer dies with
# `failed to load L"\\??\\C:\\windows\\syswow64\\ntdll.dll"` before any of its
# own code runs, which reads like a broken installer rather than a missing
# runtime — and leaves the add-to-PATH step, the whole reason the installer is
# shipped, with nothing testing it at all.
RUN dpkg --add-architecture i386 \
 && apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      cmake \
      file \
      git \
      mingw-w64 \
      mingw-w64-tools \
      ninja-build \
      nsis \
      python3 \
      wine \
      wine32:i386 \
      wine64 \
      xz-utils \
      zip \
 && rm -rf /var/lib/apt/lists/*

# None of Wine's fixme: chatter is about gittop, and there is a great deal of it.
ENV WINEDEBUG=-all
